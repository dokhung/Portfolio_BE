# ファイル名: backend/.env.example
# backendディレクトリ内で、初回のみ .env としてコピーしてください。
# DB接続情報はバックエンドだけで管理します。パスワードはローカル用の値に変更してください。
DB_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=webportfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace_with_local_password

# バックエンドの待受設定・接続を許可するフロントエンドのオリジン
SERVER_ADDRESS=127.0.0.1
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
